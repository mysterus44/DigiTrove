# =============================================================
# DigiTrove - Environment variables
# Copy to .env locally. Never commit .env.
# Generate APP_KEY with: php artisan key:generate
# =============================================================

APP_NAME=DigiTrove
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16
# Default connection = RESTRICTED runtime role (P4-B0, D-029.6): no DDL, no TEMP,
# no direct write to download_grants.downloads_count.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=digitrove
DB_USERNAME=digitrove_runtime
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSLMODE=prefer

# Migration/owner connection (P4-B0). Owns the objects and runs migrations only;
# never the application runtime. Provision the roles first with:
#   php artisan db:provision-runtime-roles
# then migrate with: php artisan migrate --database=pgsql_migration
DB_MIGRATION_USERNAME=digitrove
DB_MIGRATION_PASSWORD=digitrove_local

# Redis 7
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=file
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
REDIS_DB=0
REDIS_CACHE_DB=1

BROADCAST_CONNECTION=log

# Security
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
BCRYPT_ROUNDS=12

# Private storage for digital products. Never use public/ for deliverables.
FILESYSTEM_DISK=private

# Download grants (P4)
DOWNLOAD_LINK_TTL_HOURS=72
DOWNLOAD_MAX_PER_GRANT=5

# Payment providers (P3). Server-side confirmation only.
PAYMENT_PROVIDER=cinetpay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
WAVE_API_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Initial admin seeder (P1). Seeder reads env only, no hard-coded password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@digitrove.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional S3-compatible private storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

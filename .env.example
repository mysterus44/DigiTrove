# =============================================================
# DigiTrove - Environment variables
# Copy to .env locally. Never commit .env.
# Generate APP_KEY with: php artisan key:generate
# =============================================================

APP_NAME=DigiTrove
APP_ENV=local
APP_KEY=
# Defaut SUR, pas defaut pratique. APP_DEBUG=true en production expose les traces
# completes, les variables d'environnement et les requetes SQL sur chaque page
# d'erreur. Un poste de dev l'active dans son propre .env, jamais le gabarit.
APP_DEBUG=false
APP_URL=http://localhost:8000

ANALYTICS_INGESTION_ENABLED=false
ANALYTICS_CONSENT_VERSION=1
ANALYTICS_SESSION_TTL_MINUTES=30
ANALYTICS_SESSION_MAX_HOURS=24
ANALYTICS_RATE_LIMIT_PER_MINUTE=30
ANALYTICS_PROPERTIES_MAX_BYTES=4096
ANALYTICS_IP_HASH_KEY=
ANALYTICS_IP_HASH_KEY_VERSION=1
ANALYTICS_WORKER_DB_USERNAME=
ANALYTICS_WORKER_DB_PASSWORD=
ANALYTICS_OPERATIONS_ENABLED=false
ANALYTICS_ROLLUPS_ENABLED=false
ANALYTICS_PARTITIONS_ENABLED=false
ANALYTICS_MAX_BACKFILL_DAYS=31
ANALYTICS_PARTITION_MONTHS_AHEAD=3
ANALYTICS_PARTITION_MONTHS_BEHIND=1
ANALYTICS_STATEMENT_TIMEOUT_MS=30000
ANALYTICS_LOCK_TIMEOUT_MS=5000
ANALYTICS_DASHBOARD_ENABLED=false
ANALYTICS_READER_DB_USERNAME=
ANALYTICS_READER_DB_PASSWORD=
ANALYTICS_DASHBOARD_MAX_DAYS=366
ANALYTICS_DASHBOARD_DEFAULT_DAYS=30
ANALYTICS_DASHBOARD_CACHE_SECONDS=60
ANALYTICS_READER_STATEMENT_TIMEOUT_MS=5000
ANALYTICS_READER_LOCK_TIMEOUT_MS=1000

# P6-A0 remains dormant until a future user-facing integration is approved.
CRM_FOUNDATION_ENABLED=false
CRM_MARKETING_POLICY_VERSION=
CRM_ORDER_ATTRIBUTION_PROCESSING_ENABLED=false
CRM_ORDER_ATTRIBUTION_BATCH_SIZE=50
CRM_COMMERCE_ROLLUP_REFRESH_PROCESSING_ENABLED=false
CRM_COMMERCE_ROLLUP_REFRESH_BATCH_SIZE=50
CRM_COMMERCE_ROLLUP_BACKFILL_ENABLED=false
CRM_SEGMENT_REBUILD_ENABLED=false
CRM_SEGMENT_REBUILD_PROCESSING_ENABLED=false
CRM_SEGMENT_REBUILD_BATCH_SIZE=50

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 16
# Default connection = RESTRICTED runtime role (P4-B0, D-029.6): no DDL, no TEMP,
# no direct write to download_grants.downloads_count.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=digitrove
DB_USERNAME=digitrove_runtime
DB_PASSWORD=
DB_CHARSET=utf8
DB_SSLMODE=prefer

# Migration/owner connection (P4-B0). Owns the objects and runs migrations only;
# never the application runtime. Provision the roles first with:
#   php artisan db:provision-runtime-roles
# then migrate with: php artisan migrate --database=pgsql_migration
DB_MIGRATION_USERNAME=digitrove
DB_MIGRATION_PASSWORD=digitrove_local

# Redis 7
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=file
SESSION_DRIVER=redis
# Consulte UNIQUEMENT en local/testing : hors de ces environnements, `secure` et
# `http_only` sont forces a true et `same_site` borne a lax|strict (H2.2).
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
REDIS_DB=0
REDIS_CACHE_DB=1

BROADCAST_CONNECTION=log

# Security
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=1
ARGON_TIME=4
BCRYPT_ROUNDS=12

# Private storage for digital products. Never use public/ for deliverables.
FILESYSTEM_DISK=private

# Payment providers (P3). Server-side confirmation only.
WAVE_API_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Initial admin seeder (P1). Seeder reads env only, no hard-coded password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mail — configure a real SMTP provider in the untracked .env before enabling any
# sender. log, array, null, unknown/incomplete transports and unsafe composite legs
# fail closed. See docs/integrations/MAIL_PROVIDER_SETUP.md.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
# Intentionally blank in this template: a real provider hostname is mandatory.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@digitrove.com
MAIL_FROM_NAME="${APP_NAME}"

# Secure delivery pipeline (P4-C0, D-035). DISABLED by default.
DELIVERY_PIPELINE_ENABLED=false
DELIVERY_GRANT_TTL_MINUTES=10080
DELIVERY_GRANT_MAX_DOWNLOADS=5
DELIVERY_JOB_UNIQUE_SECONDS=3600
DELIVERY_ATTEMPT_TTL_SECONDS=900
DELIVERY_AUTH_RATE_LIMIT_PER_MINUTE=10
DELIVERY_FILE_RATE_LIMIT_PER_MINUTE=60
DELIVERY_IP_HASH_KEY=
DELIVERY_IP_HASH_KEY_VERSION=1
DELIVERY_LOG_RETENTION_DAYS=90
DELIVERY_PRIVATE_DISKS=private
DELIVERY_FILE_DRIVER=stream
DELIVERY_STREAM_CHUNK_BYTES=1048576
DELIVERY_ACCELERATION_DRIVER=none
DELIVERY_X_ACCEL_PREFIX=
DELIVERY_X_ACCEL_MIN_BYTES=0
DELIVERY_STARTED_RECONCILE_MINUTES=30
DELIVERY_REVOKED_GRANT_RETENTION_DAYS=365
DELIVERY_ABUSE_WINDOW_HOURS=24
DELIVERY_ABUSE_DISTINCT_IP_THRESHOLD=3
DELIVERY_OPS_BATCH_SIZE=500
# Required (and HTTPS-bound outside local/testing) only when the pipeline is enabled.
DELIVERY_DOWNLOAD_BASE_URL=

# Optional S3-compatible private storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
CHECKOUT_PENDING_TTL_MINUTES=30

# Payments (P3-D4). Disabled by default: leave PAYMENT_DRIVER empty.
# Set PAYMENT_DRIVER=cinetpay or PAYMENT_DRIVER=geniuspay only with real,
# complete credentials. An incomplete adapter fails closed and issues no request.
PAYMENT_DRIVER=

CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_INIT_URL=https://api-checkout.cinetpay.com/v2/payment
CINETPAY_CHECK_URL=https://api-checkout.cinetpay.com/v2/payment/check
CINETPAY_CHANNELS=MOBILE_MONEY
CINETPAY_LANG=fr
CINETPAY_CONNECT_TIMEOUT=5
CINETPAY_TIMEOUT=15
CINETPAY_NOTIFY_URL=
CINETPAY_RETURN_URL=

# GeniusPay. SANDBOX FIRST: use the sandbox credentials only
# (pk_sandbox_… / sk_sandbox_… / whsec_sandbox_…). Switching to the live keys is a
# human decision taken here, never in code, and only once sandbox is proven end to
# end. See docs/integrations/GENIUSPAY_SETUP.md.
GENIUSPAY_ENVIRONMENT=sandbox
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant
GENIUSPAY_CONNECT_TIMEOUT=5
GENIUSPAY_TIMEOUT=15
GENIUSPAY_WEBHOOK_TOLERANCE=300

# PowerPay is NOT implemented: no endpoints/statuses are known yet. See
# docs/integrations/POWERPAY_SETUP.md. PAYMENT_DRIVER=powerpay fails closed.
POWERPAY_BASE_URL=
POWERPAY_INIT_PATH=
POWERPAY_VERIFY_PATH=
POWERPAY_API_KEY=
POWERPAY_MERCHANT_ID=
POWERPAY_WEBHOOK_SECRET=
POWERPAY_SIGNATURE_HEADER=
